---
import '../styles/global.css';

const {
  title = 'Smit Malde — Electrical Design Engineer',
  description = "Smit Malde — Electrical Design Engineer on Tesla's Battery Electronics team. UC Berkeley EECS '25. Hardware design, validation, and AI-driven engineering workflows.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta name="theme-color" content="#08080d" />
  <script is:inline>
    // pre-paint: honor a stored motion preference so the reduced-motion
    // CSS gate can be bypassed without a flash (persisted per browser)
    (function () {
      try {
        var m = localStorage.getItem('silk-motion');
        if (m === 'on' || location.search.indexOf('motion=force') > -1)
          document.documentElement.classList.add('force-motion');
      } catch (e) {}
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@200;300;400;500&family=Instrument+Serif:ital@1&display=swap"
    rel="stylesheet"
    media="print"
    onload="this.media='all'"
  />
  <noscript>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@200;300;400;500&family=Instrument+Serif:ital@1&display=swap" rel="stylesheet" />
  </noscript>
</head>
<body>
  <canvas id="silk" aria-hidden="true"></canvas>
  <div class="veil" aria-hidden="true"></div>
  <div id="grain" aria-hidden="true"></div>

  <slot />

  <button id="motionToggle" class="motion-toggle" type="button" hidden></button>

  <script>
    import { startAtmosphere } from '../scripts/atmosphere.js';
    import { startMotion } from '../scripts/motion.js';
    import { startOverlays } from '../scripts/overlay.js';
    import { startLightbox } from '../scripts/lightbox.js';
    import { startJetski } from '../scripts/jetski.js';

    // Motion preference: stored choice > ?motion=force > OS reduced-motion.
    // Visitors with OS reduced-motion get a calm site plus a persistent
    // "Enable Motion" toggle; everyone else gets full motion by default.
    let stored = null;
    try { stored = localStorage.getItem('silk-motion'); } catch (e) {}
    const osRM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const forceMotion = location.search.includes('motion=force') || stored === 'on';
    const reducedMotion = stored === 'off' ? true : (!forceMotion && osRM);
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (reducedMotion) console.info('[silk] motion is reduced (OS setting or stored choice) — use the Motion toggle, ?motion=force, or Windows Settings > Accessibility > Visual effects > Animation effects.');
    if (!fine) console.info('[silk] no fine pointer detected — jetski and hover motion disabled.');

    const tog = document.getElementById('motionToggle');
    if (tog && (osRM || stored)) {
      tog.hidden = false;
      tog.textContent = reducedMotion ? 'Enable Motion' : 'Reduce Motion';
      tog.addEventListener('click', () => {
        try { localStorage.setItem('silk-motion', reducedMotion ? 'on' : 'off'); } catch (e) {}
        location.reload();
      });
    }

    startAtmosphere({ reducedMotion });
    startMotion({ reducedMotion, fine });
    startOverlays();
    startLightbox();
    startJetski({ reducedMotion, fine });
  </script>
</body>
</html>
