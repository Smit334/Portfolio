---
import { Image } from 'astro:assets';
import { cards } from '../data/site.js';

const pad = (n) => String(n).padStart(2, '0');

// Card order is hand-curated by Smit: the order of `cards` in site.js is the order.
const ordered = cards;
---
<section class="sec" id="work">
  <div class="sec-h reveal">
    <h2>Selected Work</h2>
    <span class="ln"></span>
  </div>

  <div class="card-grid">
    {ordered.map((c, n) => {
      const inner = (
        <>
          <span class="card-top">
            <span class="idx">{pad(n + 1)}</span>
            {c.thumb ? (
              <span class="card-thumb">
                <Image src={c.thumb} alt="" width={128} format="webp" quality={75} />
              </span>
            ) : (
              (c.overlay || c.href) && <span class="cta"><span class="ar">&rarr;</span></span>
            )}
          </span>
          <span class="ttl">{c.title}</span>
          <span class="desc">{c.desc}</span>
          <span class="tags">
            {c.tags.map((t) => <span>{t}</span>)}
            {c.nda && <span class="nda">Details Under NDA</span>}
            {c.overlay && <span class="more">View Details &rarr;</span>}
          </span>
        </>
      );
      if (c.overlay) return (
        <button class="card reveal" type="button" data-open-overlay={c.overlay} aria-haspopup="dialog" aria-label={`${c.title} — open details`}>{inner}</button>
      );
      if (c.href) return (
        <a class="card reveal" href={c.href} target="_blank" rel="noopener" aria-label={`${c.title} — view on GitHub`}>{inner}</a>
      );
      return <div class="card reveal">{inner}</div>;
    })}
  </div>
</section>
