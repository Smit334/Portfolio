---
import { experience, education } from '../data/site.js';
---
<section class="sec" id="experience">
  <div class="sec-h reveal">
    <h2>Experience</h2>
    <span class="ln"></span>
  </div>
  <div class="xp">
    {experience.map((e) => (
      <article class="xp-row">
        <div>
          <h3 class="xp-role">{e.role}</h3>
          <p class="xp-co">{e.company}</p>
        </div>
        <p class="xp-desc">{e.description}</p>
        <p class="xp-dates">{e.dates}</p>
      </article>
    ))}
  </div>
  <div class="edu reveal">
    <div>
      <h3>{education.school}</h3>
      <p class="edu-deg">{education.degree}</p>
    </div>
    <p class="edu-date">Graduated {education.gradDate}</p>
  </div>
</section>
